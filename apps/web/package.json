{
	"name": "web",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "pnpm run build:packages && vp dev",
		"build": "pnpm run build:packages && vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"lint": "pnpm -w lint",
		"format": "pnpm -w format",
		"test": "pnpm run test:ci && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"test:unit": "vp test",
		"test:ci": "vp test --run",
		"share-cards": "node scripts/generate-share-cards.ts",
		"build:packages": "pnpm -r --filter=\"../../packages/*\" run build"
	},
	"devDependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource/bricolage-grotesque": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.54.0",
		"@playwright/test": "catalog:",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-cloudflare": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@twinkleplop/bash": "^0.1.7",
		"@twinkleplop/markdown-core": "^0.2.1",
		"@twinkleplop/svelte": "^0.1.7",
		"@twinkleplop/typescript": "^0.1.7",
		"@types/node": "^26.6.4",
		"@typescript/native": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"daisyui": "^5.5.8",
		"fathom-client": "^3.7.2",
		"lucide": "^1.54.0",
		"mdsvex": "^0.12.8",
		"morphicons": "^1.7.1",
		"playwright": "catalog:",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"svead": "^0.0.16",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"sveltekit-embed": "workspace:*",
		"tailwindcss": "^4.1.17",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:",
		"wrangler": "catalog:"
	}
}
