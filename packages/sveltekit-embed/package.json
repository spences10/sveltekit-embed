{
	"name": "sveltekit-embed",
	"version": "0.0.22",
	"description": "A collection of embed components for SvelteKit. Easily embed content from YouTube, Spotify, Vimeo, CodePen, and many more with performant, lazy-loaded components.",
	"keywords": [
		"codepen",
		"components",
		"deezer",
		"embed",
		"gist",
		"github",
		"iframe",
		"intersection-observer",
		"lazy-loading",
		"mastodon",
		"performance",
		"responsive",
		"soundcloud",
		"spotify",
		"svelte",
		"sveltekit",
		"twitter",
		"typescript",
		"ui-components",
		"vimeo",
		"youtube"
	],
	"homepage": "https://github.com/spences10/sveltekit-embed#readme",
	"bugs": {
		"url": "https://github.com/spences10/sveltekit-embed/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Scott Spence",
		"email": "yo@scottspence.dev",
		"url": "https://scottspence.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/spences10/sveltekit-embed.git",
		"directory": "packages/sveltekit-embed"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/spences10"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && pnpm run package",
		"preview": "vp preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm run package",
		"test": "pnpm run test:integration && pnpm run test:ci",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"lint": "pnpm -w lint",
		"format": "pnpm -w format",
		"coverage": "vp test --run --coverage",
		"test:integration": "playwright test",
		"test:unit": "vp test",
		"test:ci": "vp test --run"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@typescript/native": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"playwright": "catalog:",
		"publint": "^0.3.21",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"engines": {
		"node": ">=24.15.0"
	}
}
